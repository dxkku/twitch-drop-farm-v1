PORT=6767
API_KEY=change-this-to-something-secret
DOMAIN=yourdomain.com
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Twitch App (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://YOUR_SERVER_IP:6767/api/twitch/callback

# Discord bot (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# IMAP email reading — for receiving Twitch verification codes
# RECOMMENDED: Use Gmail (gmail.com) — trusted by Twitch, never blocklisted, instant code delivery via IMAP IDLE
# Custom domains (Cloudflare, etc.) can get blocklisted by Twitch. Gmail is the safest choice.
#
# Setup:
#   1. Go to Google Account → Security → 2-Step Verification → App Passwords
#   2. Create an App Password for "Mail"
#   3. Fill in below — use the 16-character App Password for IMAP_PASS (not your Google login password)
#
# Register each Twitch account with a unique Gmail alias, e.g.:
#   youremail+acc001@gmail.com
#   youremail+acc002@gmail.com
#   youremail+acc003@gmail.com
#   (All go to the same inbox — IMAP reader sorts them automatically)
#
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=youremail@gmail.com
IMAP_PASS=xxxx xxxx xxxx xxxx

# Server mode — set to 1 when running on a Windows Server or Linux VPS
# Uses src/stealth/serverLauncher.js instead of the desktop launcher
# Windows Server: connect via RDP first so Chrome has a display to use
# Linux VPS: install Xvfb first:  apt-get install -y xvfb
SERVER_MODE=0
