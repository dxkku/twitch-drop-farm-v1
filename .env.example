PORT=6767
API_KEY=change-this-to-something-secret
DOMAIN=yourdomain.com
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Twitch App (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://YOUR_SERVER_IP:6767/api/twitch/callback

# Discord bot (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# IMAP email reading — for receiving Twitch verification codes
# Fill these in to use your domain email instead of temp mail
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Server mode — set to 1 when running on a Windows Server or Linux VPS
# Uses src/stealth/serverLauncher.js instead of the desktop launcher
# Windows Server: connect via RDP first so Chrome has a display to use
# Linux VPS: install Xvfb first:  apt-get install -y xvfb
SERVER_MODE=0
